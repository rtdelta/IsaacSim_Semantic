{
  "schema_version": 1,
  "name": "pathtracing_stable_64spp_example",
  "renderer": "PathTracing",
  "launch_settings": {
    "anti_aliasing": 0,
    "denoiser": true,
    "samples_per_pixel_per_frame": 8,
    "max_bounces": 4,
    "max_specular_transmission_bounces": 6,
    "max_volume_bounces": 64
  },
  "settings": {
    "/rtx/rendermode": "PathTracing",
    "/rtx/pathtracing/spp": 8,
    "/rtx/pathtracing/totalSpp": 64,
    "/rtx/pathtracing/adaptiveSampling/enabled": false,
    "/rtx/pathtracing/maxBounces": 4,
    "/rtx/pathtracing/maxSpecularAndTransmissionBounces": 6,
    "/rtx/pathtracing/maxVolumeBounces": 64,
    "/rtx/resetPtAccumOnAnimTimeChange": true,
    "/rtx/pathtracing/fractionalCutoutOpacity": true
  }
}
