        "prim_path": null
      },
      "body1": {
        "reference_type": "link",
        "reference_id": "boom",
        "prim_path": null
      },
      "geometry": {
        "source": "calibration_file",
        "calibration_id": "cab_boom_joint",
        "coordinate_frame": "source_mesh_numeric_frame",
        "center_override": null,
        "axis_override": null,
        "axis_sign": 1
      },
      "limits": {
