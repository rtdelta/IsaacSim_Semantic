  ],
  "physics_scene": {
    "author_in_asset": false,
    "prim_path": "/PhysicsScene",
    "gravity_direction": [0.0, 0.0, -1.0],
    "gravity_magnitude": 9.81,
    "time_steps_per_second": 60
  },
  "semantics": {
    "enabled": true,
    "api": "SemanticsAPI",
    "instance_name": "class",
    "apply_to": "gaussian_prim",
    "allow_duplicate_labels": true,
    "apply_to_mesh": false
  },
  "outputs": {
    "entry_file": "excavator_floating.usda",
    "visual_layer_file": "excavator_visual.usda",
    "physics_layer_file": "excavator_physics.usda",
    "mesh_layer_file": "mesh_parts.usdc",
    "gaussian_parts": {
      "one_file_per_part": true,
      "directory": "gaussian_parts",
      "file_format": "usdc"
    },
    "use_relative_asset_paths": true,
    "write_resolved_config": true,
    "resolved_config_file": "resolved_build_config.json",
    "write_validation_report": true,
    "validation_report_file": "build_validation_report.json",
    "write_debug_stage": true,
    "debug_stage_file": "excavator_debug.usda",
    "overwrite_policy": "error"
  },
  "validation": {
    "strict_mode": true,
    "expected_counts": {
      "enabled_links": null,
      "enabled_joints": null,
      "enabled_gaussian_parts": null,
      "enabled_mesh_parts": null
    },
    "require_unique_ids": true,
    "require_unique_prim_paths": true,
    "require_existing_input_files": true,
    "require_every_part_has_link": true,
    "require_joint_bodies_resolve_to_links": true,
    "require_connected_articulation": true,
    "required_topology": "chain",
    "require_finite_joint_limits": true,
    "require_positive_mass": true,
    "require_positive_diagonal_inertia": true,
    "max_joint_fit_rms_error_m": null,
    "max_mesh_gaussian_bounds_difference_m": null,
    "fail_on_warning": false
  },
  "execution": {
    "dry_run": false,
    "log_level": "INFO",
    "stop_after_phase": null
