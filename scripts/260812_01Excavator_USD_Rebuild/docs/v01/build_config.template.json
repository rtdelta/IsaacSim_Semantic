    {
      "id": "arm_bucket_joint",
      "enabled": true,
      "display_name": "Arm Bucket Joint",
      "type": "revolute",
      "prim_path": "Joints/arm_bucket_joint",
      "body0": {
        "reference_type": "link",
        "reference_id": "arm",
        "prim_path": null
      },
      "body1": {
        "reference_type": "link",
